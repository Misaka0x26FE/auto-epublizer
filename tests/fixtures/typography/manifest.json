{
  "schema_version": 1,
  "description": "排版工程化样本册（P1）：12 类合成场景 + 一册自然跨页的整书；全部文本与图片由构建器生成，不含真实作品内容。",
  "book": {
    "slug": "typography-samples",
    "title": "排版样本册",
    "lang": "zh-CN",
    "creator": "合成样本"
