          "expect": {
            "markers": ["TYPO-NOTE-A", "TYPO-NOTE-B"],
            "noterefs": 5,
            "asides": 4,
            "images": ["note-small.png"],
            "selectors": ["<aside", "epub:type=\"footnotes\"", "epub:type=\"backlink\""]
