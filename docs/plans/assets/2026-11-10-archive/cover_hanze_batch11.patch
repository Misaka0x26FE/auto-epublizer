+    cy = top + h * 0.60
+    r = w * 0.30
+    # 绶带
+    page.draw_polyline(
+        [
+            pymupdf.Point(cx - w * 0.20, top + h * 0.02),
+            pymupdf.Point(cx - w * 0.08, cy - r * 0.55),
+            pymupdf.Point(cx + w * 0.08, cy - r * 0.55),
+            pymupdf.Point(cx + w * 0.20, top + h * 0.02),
+        ],
+        color=accent,
+        width=1.2,
+    )
+    page.draw_line(
+        pymupdf.Point(cx - w * 0.135, top + h * 0.02),
+        pymupdf.Point(cx + w * 0.135, top + h * 0.02),
+        color=accent,
+        width=1.2,
+    )
+    # 圆章
+    page.draw_circle(pymupdf.Point(cx, cy), r, color=accent, width=1.4)
+    page.draw_circle(pymupdf.Point(cx, cy), r * 0.86, color=faint, width=0.6)
+    # 八角星
+    for k in range(8):
+        ang = math.radians(22.5 + k * 45)
+        page.draw_line(
+            pymupdf.Point(cx, cy),
+            pymupdf.Point(cx + r * 0.62 * math.cos(ang), cy - r * 0.62 * math.sin(ang)),
+            color=accent,
+            width=0.8,
