+# ---------------------------------------------------------------- 本书意象（批次 11 十本）
+# 每个函数只画“意象区”内的线条，纸张、双线框、四段式文字与署名仍由 draw() 统一负责。
+
+
+def _motif_screen(page, cx, top, bottom, width, accent, faint):
+    """银幕与胶片：政权媒体生产（伊朗）。"""
+    h = bottom - top
+    w = min(width, h * 1.32)
+    left, right = cx - w / 2, cx + w / 2
+    s_top, s_bot = top + h * 0.10, top + h * 0.64
+    page.draw_rect(pymupdf.Rect(left, s_top, right, s_bot), color=accent, width=1.3)
+    # 银幕内的三道微光
+    for i in range(1, 4):
+        y = s_top + (s_bot - s_top) * i / 4
+        page.draw_line(
+            pymupdf.Point(left + w * 0.06, y),
+            pymupdf.Point(right - w * 0.06, y),
+            color=faint,
+            width=0.4,
+        )
+    # 胶片带（两条，带齿孔）
+    for y0, step in ((s_bot + h * 0.08, 1), (s_bot + h * 0.16, -1)):
+        page.draw_line(
+            pymupdf.Point(left, y0), pymupdf.Point(right, y0), color=accent, width=0.9
+        )
+        page.draw_line(
+            pymupdf.Point(left, y0 + h * 0.045),
+            pymupdf.Point(right, y0 + h * 0.045),
+            color=accent,
+            width=0.9,
+        )
+        n = 12
+        for i in range(n):
+            x = left + w * (i + 0.5) / n
+            page.draw_rect(
+                pymupdf.Rect(x - w * 0.012, y0 + h * 0.012, x + w * 0.012, y0 + h * 0.033),
+                color=faint,
+                width=0.4,
+            )
+    # 放映机镜头（胶片带下方的小圆）
+    page.draw_circle(
+        pymupdf.Point(cx - w * 0.30, s_bot + h * 0.28), w * 0.030, color=accent, width=0.8
+    )
+    page.draw_circle(
+        pymupdf.Point(cx - w * 0.30, s_bot + h * 0.28), w * 0.012, color=None, fill=accent, width=0
+    )
+
+
+def _motif_guard(page, cx, top, bottom, width, accent, faint):
+    """盾徽与三道山形纹：革命卫队（伊朗）。"""
+    h = bottom - top
+    w = min(width, h * 0.78)
+    left, right = cx - w / 2, cx + w / 2
+    y0, y1 = top + h * 0.08, bottom - h * 0.06
+    # 盾牌：上直下尖
+    pts = [
+        pymupdf.Point(left, y0 + h * 0.10),
+        pymupdf.Point(cx, y0),
+        pymupdf.Point(right, y0 + h * 0.10),
+        pymupdf.Point(right, y1 - h * 0.30),
+        pymupdf.Point(cx, y1),
+        pymupdf.Point(left, y1 - h * 0.30),
+        pymupdf.Point(left, y0 + h * 0.10),
+    ]
+    page.draw_polyline(pts, color=accent, width=1.4)
+    page.draw_polyline(pts, color=accent, width=0.5, closePath=True)
+    # 三道山形纹
+    for i in range(3):
+        yy = y0 + h * (0.30 + i * 0.16)
+        page.draw_polyline(
+            [
+                pymupdf.Point(left + w * 0.18, yy),
+                pymupdf.Point(cx, yy - h * 0.09),
+                pymupdf.Point(right - w * 0.18, yy),
+            ],
+            color=faint if i else accent,
+            width=1.0 if i == 0 else 0.6,
+        )
+    # 顶部星
+    star_r = w * 0.075
+    cy_star = y0 + h * 0.16
+    page.draw_circle(pymupdf.Point(cx, cy_star), star_r, color=accent, width=0.9)
+    for deg in (90, 210, 330):
+        ang = math.radians(deg)
+        page.draw_line(
+            pymupdf.Point(cx, cy_star),
+            pymupdf.Point(cx + star_r * math.cos(ang), cy_star - star_r * math.sin(ang)),
+            color=accent,
+            width=0.7,
+        )
+
