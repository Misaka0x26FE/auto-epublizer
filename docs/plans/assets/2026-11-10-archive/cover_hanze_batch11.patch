+    page.draw_line(pymupdf.Point(lx - w * 0.07, ly - h * 0.10), pymupdf.Point(lx, ly - h * 0.20), color=accent, width=0.9)
+    page.draw_line(pymupdf.Point(lx + w * 0.07, ly - h * 0.10), pymupdf.Point(lx, ly - h * 0.20), color=accent, width=0.9)
+    # 火苗
+    page.draw_polyline(
+        [
