+    page.draw_circle(pymupdf.Point(cx, cy), r * 0.10, color=None, fill=accent, width=0)
+    # 下方月桂托
+    for s in (-1, 1):
+        pts = [
+            pymupdf.Point(cx + s * w * 0.34, cy + r * 1.18),
+            pymupdf.Point(cx + s * w * 0.20, cy + r * 0.95),
+            pymupdf.Point(cx + s * w * 0.04, cy + r * 0.90),
+        ]
+        page.draw_polyline(pts, color=faint, width=0.7)
+
