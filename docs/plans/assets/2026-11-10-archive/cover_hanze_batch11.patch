+def _motif_archive(page, cx, top, bottom, width, accent, faint):
+    """叠放的照片与连线：记忆研究（乌克兰）。"""
+    h = bottom - top
+    w = min(width, h * 0.90)
+    left, right = cx - w / 2, cx + w / 2
+    # 三张错位相片
+    for i, (dx, dy, tilt) in enumerate(((0.00, 0.00, 0), (0.06, 0.09, 1), (-0.05, 0.18, -1))):
+        x0 = left + w * dx
+        y0 = top + h * 0.06 + h * dy
+        page.draw_rect(
+            pymupdf.Rect(x0, y0, x0 + w * 0.52, y0 + h * 0.38),
+            color=accent if i == 0 else faint,
+            width=1.1 if i == 0 else 0.6,
+        )
+        # 相片内两道横线（人物/风景的抽象）
+        page.draw_line(
+            pymupdf.Point(x0 + w * 0.06, y0 + h * 0.12),
+            pymupdf.Point(x0 + w * 0.46, y0 + h * 0.12),
+            color=faint,
+            width=0.4,
+        )
+        page.draw_line(
+            pymupdf.Point(x0 + w * 0.06, y0 + h * 0.25),
+            pymupdf.Point(x0 + w * 0.38, y0 + h * 0.25),
+            color=faint,
+            width=0.4,
+        )
+    # 红色记忆线：穿过三张照片
+    page.draw_polyline(
+        [
+            pymupdf.Point(left + w * 0.10, bottom - h * 0.22),
+            pymupdf.Point(cx, bottom - h * 0.10),
+            pymupdf.Point(right - w * 0.06, bottom - h * 0.26),
+        ],
+        color=accent,
+        width=1.4,
+    )
+    for x in (left + w * 0.10, cx, right - w * 0.06):
+        page.draw_circle(pymupdf.Point(x, bottom - h * 0.24), w * 0.012, color=None, fill=accent, width=0)
+
