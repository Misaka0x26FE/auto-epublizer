+def _motif_trident(page, cx, top, bottom, width, accent, faint):
+    """三叉戟与松林：乌克兰民族主义地下组织（卢布林地区）。"""
+    h = bottom - top
+    w = min(width, h * 0.86)
+    left, right = cx - w / 2, cx + w / 2
+    cy = top + h * 0.46
+    # 中央矛头
+    page.draw_polyline(
+        [
+            pymupdf.Point(cx, top + h * 0.02),
+            pymupdf.Point(cx - w * 0.045, top + h * 0.12),
+            pymupdf.Point(cx, top + h * 0.10),
+            pymupdf.Point(cx + w * 0.045, top + h * 0.12),
+            pymupdf.Point(cx, top + h * 0.02),
+        ],
+        color=accent,
+        width=1.2,
+    )
+    page.draw_line(pymupdf.Point(cx, top + h * 0.10), pymupdf.Point(cx, cy), color=accent, width=1.2)
+    # 两侧弯钩
+    for s in (-1, 1):
+        page.draw_polyline(
+            [
+                pymupdf.Point(cx + s * w * 0.20, top + h * 0.08),
+                pymupdf.Point(cx + s * w * 0.26, top + h * 0.20),
+                pymupdf.Point(cx + s * w * 0.20, cy - h * 0.06),
+                pymupdf.Point(cx + s * w * 0.10, cy - h * 0.02),
+                pymupdf.Point(cx + s * w * 0.10, cy),
+            ],
+            color=accent,
+            width=1.1,
+        )
+    # 松树剪影（三棵）
+    for i, xf in enumerate((0.18, 0.50, 0.82)):
+        base = bottom - h * 0.04
+        top_y = bottom - h * (0.30 if i != 1 else 0.36)
+        x = left + w * xf
+        page.draw_polyline(
+            [
+                pymupdf.Point(x - w * 0.06, base),
+                pymupdf.Point(x, top_y),
+                pymupdf.Point(x + w * 0.06, base),
+            ],
+            color=faint,
+            width=0.7,
+        )
+        page.draw_line(pymupdf.Point(x, base), pymupdf.Point(x, base - h * 0.05), color=faint, width=0.7)
