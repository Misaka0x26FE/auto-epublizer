+    for s in (-1, 1):
+        base_x = cx + s * w * 0.30
+        page.draw_line(pymupdf.Point(base_x, bottom - h * 0.06), pymupdf.Point(cx + s * w * 0.12, top + h * 0.30), color=faint, width=0.6)
+        for i in range(4):
+            yy = bottom - h * (0.12 + i * 0.09)
+            page.draw_line(
+                pymupdf.Point(cx + s * w * (0.24 - i * 0.025), yy),
+                pymupdf.Point(cx + s * w * (0.16 - i * 0.02), yy - h * 0.04),
