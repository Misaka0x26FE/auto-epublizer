+def _motif_partisan(page, cx, top, bottom, width, accent, faint):
+    """降落伞、松林与星：苏联游击队（乌克兰东线）。"""
+    h = bottom - top
+    w = min(width, h * 0.86)
+    # 伞衣
+    cy = top + h * 0.20
+    r = w * 0.26
+    pts = []
+    for i in range(21):
+        ang = math.radians(180 + 180 * i / 20)
+        pts.append(pymupdf.Point(cx + r * math.cos(ang), cy + r * 0.62 * math.sin(ang)))
+    page.draw_polyline(pts, color=accent, width=1.2)
+    page.draw_line(pymupdf.Point(cx - r, cy), pymupdf.Point(cx + r, cy), color=accent, width=0.8)
+    for i in range(-2, 3):
+        x = cx + r * i / 2.4
+        page.draw_line(
+            pymupdf.Point(x, cy + r * 0.10),
+            pymupdf.Point(cx + r * 0.10 * i, cy + r * 0.98),
+            color=faint,
+            width=0.5,
+        )
+    # 星
+    sx, sy, sr = cx, bottom - h * 0.30, w * 0.055
+    for k in range(5):
+        ang = math.radians(90 + k * 72)
+        page.draw_line(
+            pymupdf.Point(sx, sy),
+            pymupdf.Point(sx + sr * math.cos(ang), sy - sr * math.sin(ang)),
+            color=accent,
+            width=0.8,
+        )
+    # 松林
+    for i, xf in enumerate((0.10, 0.28, 0.46, 0.64, 0.82)):
+        x = cx - w / 2 + w * xf
+        base = bottom - h * 0.03
+        page.draw_polyline(
+            [
+                pymupdf.Point(x - w * 0.05, base),
+                pymupdf.Point(x, base - h * (0.18 if i % 2 else 0.24)),
+                pymupdf.Point(x + w * 0.05, base),
+            ],
+            color=faint,
+            width=0.6,
+        )
+
+
+def _motif_laurel(page, cx, top, bottom, width, accent, faint):
+    """月桂环与摊开的书：社会主义与哲学文选（索雷尔）。"""
+    h = bottom - top
+    w = min(width, h * 0.92)
+    cy = top + h * 0.42
+    rx, ry = w * 0.34, h * 0.30
+    # 左右两支月桂：半椭圆 + 叶
+    for s in (-1, 1):
+        pts = []
+        for i in range(25):
+            ang = math.radians(-80 + 160 * i / 24)
+            pts.append(
+                pymupdf.Point(cx + s * rx * math.cos(ang), cy + ry * math.sin(ang))
+            )
+        page.draw_polyline(pts, color=faint, width=0.8)
+        for i in range(1, 9):
+            ang = math.radians(-70 + 140 * i / 9)
+            px = cx + s * rx * math.cos(ang)
+            py = cy + ry * math.sin(ang)
+            page.draw_oval(
+                pymupdf.Rect(
+                    px - w * 0.028, py - h * 0.014, px + w * 0.028, py + h * 0.014
+                ),
+                color=accent,
+                width=0.5,
+            )
+    # 摊开的书（两页 + 书脊）
+    by = bottom - h * 0.14
+    left_page = [
+        pymupdf.Point(cx - w * 0.30, by + h * 0.015),
+        pymupdf.Point(cx - w * 0.30, by + h * 0.135),
+        pymupdf.Point(cx - w * 0.015, by + h * 0.165),
+        pymupdf.Point(cx - w * 0.015, by + h * 0.045),
+        pymupdf.Point(cx - w * 0.30, by + h * 0.015),
+    ]
+    right_page = [pymupdf.Point(2 * cx - p.x, p.y) for p in left_page]
+    page.draw_polyline(left_page, color=accent, width=1.1)
+    page.draw_polyline(right_page, color=accent, width=1.1)
+    page.draw_line(
+        pymupdf.Point(cx, by + h * 0.045),
+        pymupdf.Point(cx, by + h * 0.165),
+        color=accent,
+        width=0.8,
+    )
+
+
+def _motif_anvil(page, cx, top, bottom, width, accent, faint):
+    """铁砧与锤：革命工团主义（索雷尔）。"""
+    h = bottom - top
+    w = min(width, h * 0.92)
+    base = bottom - h * 0.12
+    # 砧面（上宽下窄，带角）
+    page.draw_polyline(
+        [
+            pymupdf.Point(cx - w * 0.30, base - h * 0.02),
+            pymupdf.Point(cx - w * 0.30, base - h * 0.16),
+            pymupdf.Point(cx - w * 0.10, base - h * 0.22),
+            pymupdf.Point(cx + w * 0.18, base - h * 0.22),
+            pymupdf.Point(cx + w * 0.30, base - h * 0.30),
+            pymupdf.Point(cx + w * 0.30, base - h * 0.16),
+            pymupdf.Point(cx + w * 0.10, base - h * 0.08),
+            pymupdf.Point(cx + w * 0.10, base),
+        ],
+        color=accent,
+        width=1.3,
+    )
+    page.draw_line(
+        pymupdf.Point(cx - w * 0.10, base - h * 0.08),
+        pymupdf.Point(cx - w * 0.10, base),
+        color=accent,
+        width=1.3,
+    )
+    page.draw_line(
+        pymupdf.Point(cx - w * 0.10, base),
+        pymupdf.Point(cx + w * 0.10, base),
+        color=accent,
+        width=1.3,
+    )
+    page.draw_line(
+        pymupdf.Point(cx - w * 0.30, base - h * 0.02),
+        pymupdf.Point(cx - w * 0.10, base - h * 0.02),
+        color=faint,
+        width=0.5,
+    )
+    # 锤：柄从左下斜向右上，锤头落在砧面上方
+    hx0, hy0 = cx - w * 0.16, base - h * 0.24
+    hx1, hy1 = cx + w * 0.26, base - h * 0.46
+    page.draw_line(pymupdf.Point(hx0, hy0), pymupdf.Point(hx1, hy1), color=accent, width=2.2)
+    # 锤头（垂直于柄的短粗矩形）
+    dx, dy = hx1 - hx0, hy1 - hy0
+    n = math.hypot(dx, dy) or 1
+    ux, uy = dx / n, dy / n
+    px, py = -uy, ux
+    half_l, half_w = w * 0.055, w * 0.030
+    corners = []
+    for a, b in ((-1, -1), (1, -1), (1, 1), (-1, 1)):
+        corners.append(
+            pymupdf.Point(
+                hx1 + ux * half_l * a + px * half_w * b,
+                hy1 + uy * half_l * a + py * half_w * b,
+            )
+        )
+    page.draw_polyline(corners + [corners[0]], color=accent, width=1.1)
+
+
